# Your OpenAI key
OPENAI_API_KEY=

# Text + vision model. If you get a "model not found" error, start the server
# and open http://localhost:5174/api/models to see what your key can use.
OPENAI_MODEL=gpt-6-luna

# Image generation model, used by the Picture button in the Assistant.
# Images cost far more than text -- see the Usage panel.
OPENAI_IMAGE_MODEL=gpt-image-2

PORT=5174

# Reasoning models reject function tools on /v1/chat/completions unless
# reasoning is off, so the assistant sends 'none' when it needs the picture
# tools. Set this only if your model wants something else.
# OPENAI_REASONING_EFFORT=none
